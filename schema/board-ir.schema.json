{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oxyflour/webgpu-layout/schema/board-ir.schema.json",
  "title": "Board IR (webgpu-pin-layout/board@1)",
  "description": "Structural schema of the Board IR. Units: mm and degrees. Cross references (pad nets, module footprints, regions) and uniqueness are checked by src/ir/validate.js. See docs/board-ir.md.",
  "type": "object",
  "required": ["format", "board", "nets", "footprints"],
  "properties": {
    "format": { "const": "webgpu-pin-layout/board@1" },
    "yAxis": { "enum": ["down", "up"], "default": "down" },
    "name": { "type": "string" },
    "source": { "type": "object" },
    "board": { "$ref": "#/$defs/board" },
    "nets": { "type": "array", "items": { "$ref": "#/$defs/net" } },
    "footprints": { "type": "array", "items": { "$ref": "#/$defs/footprint" } },
    "regions": { "type": "array", "items": { "$ref": "#/$defs/region" } },
    "keepouts": { "type": "array", "items": { "$ref": "#/$defs/keepout" } },
    "modules": { "type": "array", "items": { "$ref": "#/$defs/module" } },
    "rules": { "$ref": "#/$defs/rules" },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "number": { "type": "number" },
    "point": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "minItems": 2, "maxItems": 2 },
    "ring": { "type": "array", "items": { "$ref": "#/$defs/point" }, "minItems": 3 },
    "side": { "enum": ["top", "bottom"] },
    "extensions": { "type": "object", "description": "Opaque data preserved but ignored by the engine." },
    "shape": {
      "oneOf": [
        {
          "type": "object", "required": ["type", "x", "y", "width", "height"],
          "properties": { "type": { "const": "rect" }, "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } }
        },
        {
          "type": "object", "required": ["type", "center", "radius"],
          "properties": { "type": { "const": "circle" }, "center": { "$ref": "#/$defs/point" }, "radius": { "type": "number", "exclusiveMinimum": 0 } }
        },
        {
          "type": "object", "required": ["type", "points"],
          "properties": { "type": { "const": "polygon" }, "points": { "$ref": "#/$defs/ring" }, "holes": { "type": "array", "items": { "$ref": "#/$defs/ring" } } }
        }
      ]
    },
    "board": {
      "type": "object", "required": ["outline"],
      "properties": {
        "outline": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["outer"],
            "properties": { "outer": { "$ref": "#/$defs/ring" }, "holes": { "type": "array", "items": { "$ref": "#/$defs/ring" } } }
          }
        },
        "thickness": { "type": "number", "exclusiveMinimum": 0 },
        "sides": { "type": "array", "items": { "$ref": "#/$defs/side" }, "minItems": 1, "uniqueItems": true },
        "copperLayers": {
          "type": "array",
          "items": {
            "type": "object", "required": ["name"],
            "properties": { "name": { "type": "string" }, "side": { "$ref": "#/$defs/side" }, "type": { "enum": ["signal", "plane", "mixed"] }, "net": { "type": "string" } }
          }
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "net": {
      "type": "object", "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "class": { "enum": ["signal", "power", "ground"], "default": "signal" },
        "priority": { "type": "number", "minimum": 0, "maximum": 100, "default": 50 },
        "ignore": { "type": "boolean", "default": false },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "pad": {
      "type": "object", "required": ["id", "at", "size"],
      "properties": {
        "id": { "type": "string" },
        "at": { "$ref": "#/$defs/point" },
        "shape": { "enum": ["rect", "roundrect", "oval", "circle", "polygon"], "default": "rect" },
        "size": { "type": "array", "prefixItems": [{ "type": "number", "exclusiveMinimum": 0 }, { "type": "number", "exclusiveMinimum": 0 }], "minItems": 2, "maxItems": 2 },
        "points": { "$ref": "#/$defs/ring" },
        "cornerRadius": { "type": "number", "minimum": 0 },
        "rotation": { "type": "number", "default": 0 },
        "type": { "enum": ["smd", "through", "npth"], "default": "smd" },
        "drill": { "type": "number", "exclusiveMinimum": 0 },
        "net": { "type": ["string", "null"], "default": null },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "placement": {
      "type": "object", "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "rotation": { "type": "number", "default": 0 }, "side": { "$ref": "#/$defs/side", "default": "top" } }
    },
    "footprint": {
      "type": "object", "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "value": { "type": "string" },
        "library": { "type": "string" },
        "pads": { "type": "array", "items": { "$ref": "#/$defs/pad" }, "default": [] },
        "courtyard": { "$ref": "#/$defs/shape" },
        "height": { "type": "number", "minimum": 0 },
        "placement": { "$ref": "#/$defs/placement" },
        "fixed": { "type": "boolean", "default": false },
        "allowedSides": { "type": "array", "items": { "$ref": "#/$defs/side" }, "minItems": 1, "uniqueItems": true },
        "allowedRotations": { "type": "array", "items": { "type": "number" }, "minItems": 1 },
        "mechanical": { "type": "boolean" },
        "region": { "type": ["string", "null"], "default": null },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "if": { "properties": { "fixed": { "const": true } }, "required": ["fixed"] },
      "then": { "required": ["placement"] }
    },
    "region": {
      "type": "object", "required": ["id", "shape"],
      "properties": { "id": { "type": "string" }, "shape": { "$ref": "#/$defs/shape" }, "sides": { "type": "array", "items": { "$ref": "#/$defs/side" } }, "extensions": { "$ref": "#/$defs/extensions" } }
    },
    "keepout": {
      "type": "object", "required": ["shape"],
      "properties": {
        "id": { "type": "string" },
        "shape": { "$ref": "#/$defs/shape" },
        "sides": { "type": "array", "items": { "$ref": "#/$defs/side" } },
        "rules": { "type": "object", "properties": { "placement": { "type": "boolean" }, "routing": { "type": "boolean" }, "vias": { "type": "boolean" } } },
        "maxHeight": { "type": ["number", "null"] },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "module": {
      "type": "object", "required": ["id", "footprints"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "footprints": { "type": "array", "items": { "type": "string" } },
        "side": { "enum": ["auto", "top", "bottom"], "default": "auto" },
        "region": { "type": ["string", "null"], "default": null },
        "cohesion": { "type": "number", "minimum": 0, "default": 0.4 },
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "rules": {
      "type": "object",
      "properties": {
        "componentClearance": { "type": "number", "minimum": 0 },
        "edgeClearance": { "type": "number", "minimum": 0 },
        "track": { "type": "object", "properties": { "width": { "type": "number", "exclusiveMinimum": 0 }, "clearance": { "type": "number", "minimum": 0 } } },
        "via": { "type": "object", "properties": { "diameter": { "type": "number", "exclusiveMinimum": 0 }, "drill": { "type": "number", "exclusiveMinimum": 0 } } }
      }
    }
  }
}
